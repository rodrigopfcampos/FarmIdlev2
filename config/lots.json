      "rule": "shared_side",
      "exempt_types": [
        "pasto_galinheiro",
        "pasto_celeiro"
      ]
    },
    "min_level": {
      "formula": "ceil(k * n)",
      "k": 1.46,
      "type_floor": {
        "pasto_galinheiro": 3,
        "pasto_celeiro": 8,
        "pomar": 10,
        "pasto_lago": 11
      }
    },
    "cost": {
      "formula": "base * growth^(n-1) * R(ceil(k * n))",
      "base": 0.28,
      "growth": 1.1,
      "rounding": "2_significant_digits"
    },
    "deed": {
      "required_from_purchase": 20,
      "total_needed": 10
    },
    "cleanup": {
      "base_minutes": 60,
      "per_purchase_minutes": 12,
      "other_class_multiplier": 2,
      "neighbor_help_reduction": 0.1,
      "max_neighbor_helps_per_day": 5
    }
  },
