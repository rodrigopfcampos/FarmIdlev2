{
  "version": 2,
  "source": "GDD v2 seção 6 (tabela do dono, 20/10/2026)",
  "rules": {
    "reference_gold_per_hour_per_plot": {
      "formula": "60 * 1.07^(level-1)",
      "note": "líquido de semente; árvore = 2 canteiros"
    },
    "seed_cost": {
      "crop": "25% do valor de 1 colheita",
      "recurring": "valor de 1 colheita",
      "orchard": "valor de 6 colheitas (muda)"
    },
    "work_units": {
      "plant": 0.5,
      "harvest": 0.5,
      "plant_and_harvest": 1,
      "extra_harvest_recurring_or_tree": 0.5,
      "per_character_per_hour": 2.67,
      "per_character_per_hour_note": "capacidade do Agricultor fora do jogo; valor da calibração da fase 0, fixo desde a fase 2 (com o jogo aberto, plantar e colher por clique não gasta trabalho)",
      "click_note": "com o jogo aberto, plantar e colher por clique não gasta trabalho; o Agricultor gasta 0,5 para plantar e 0,5 para colher"
    },
    "golden_harvest": {
      "multiplier": 2.5,
      "cap_permanent": 0.2,
      "cap_absolute": 0.6
    },
    "orchard": {
      "trees_per_lot": 4,
      "remove_tree_cost": 0,
      "remove_tree_note": "derrubar é grátis; a nova muda é paga e cresce do zero"
    },
    "recurring_xp_note": "xp_per_harvest = XP do plantio inteiro (tabela do dono) ÷ 5"
  },
